{
  "permissions": {
    "allow": [
      "Bash(curl -sL 'https://aws.amazon.com/aup/')",
      "Bash(task *)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:planetscale.com)",
      "WebFetch(domain:www.cockroachlabs.com)",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-get-comments",
      "mcp__notion__notion-get-teams",
      "mcp__notion__notion-get-users",
      "mcp__notion__notion-query-data-sources",
      "mcp__notion__notion-query-meeting-notes",
      "mcp__notion__notion-search",
      "mcp__sourcegraph__commit_search",
      "mcp__sourcegraph__deepsearch_read",
      "mcp__sourcegraph__diff_search",
      "mcp__sourcegraph__keyword_search",
      "mcp__sourcegraph__list_files",
      "mcp__sourcegraph__list_repos",
      "mcp__sourcegraph__nls_search",
      "mcp__sourcegraph__read_file"
    ]
  },
  "model": "opus[1m]",
  "effortLevel": "high",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Detect the current git branch and run /set-session-context to set session name and color.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "STOP. Before pushing, confirm: have you run the verify-when-complete workflow (fmt, lint, build, test) since the last rebase, merge, or code change? If not, do so now. Only proceed if all checks passed."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git checkout*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "The git branch just changed. Run /set-session-context to update session name and color."
          }
        ]
      },
      {
        "matcher": "Bash(git switch*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "The git branch just changed. Run /set-session-context to update session name and color."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "autoUpdatesChannel": "stable"
}
